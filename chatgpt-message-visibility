#!/bin/sh
# SPDX-License-Identifier: MIT
# Find the runtime from the currently installed package after every upgrade.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
operation=${1:---check}
installed=false
if [ "$(readlink -f -- "$0")" = /usr/local/bin/chatgpt-message-visibility ]; then installed=true; fi
selection=/usr/local/lib/chatgpt-message-visibility/mode
failure_file=/usr/local/lib/chatgpt-message-visibility/last-hook-failure
hook=false
if [ "$operation" = '--apt-hook' ]; then
  hook=true
  shift
  set -- --apply "$@"
  operation=--apply
fi
if [ "$hook" = true ] && [ "$(dpkg-query -W '-f=${db:Status-Status}' chatgpt 2>/dev/null || :)" != installed ]; then
  exit 0
fi
record_hook_failure() (
  [ "$installed" = true ] && [ "$(id -u)" = 0 ] || return 0
  failure_temp=$(mktemp "${failure_file}.XXXXXX") || return 1
  trap 'rm -f -- "$failure_temp"' EXIT HUP INT TERM
  failed_mode=$(cat -- "$selection" 2>/dev/null || :)
  case "$failed_mode" in messages|all) ;; *) failed_mode=unknown ;; esac
  failed_version=$(dpkg-query -W '-f=${Version}' chatgpt 2>/dev/null || :)
  {
    printf 'Automatic reapplication failed on %s (ChatGPT %s, selected mode %s).\n' "$(date '+%Y-%m-%d %H:%M:%S %:z')" "${failed_version:-unknown}" "$failed_mode"
    printf '%s\n' "$1" | head -c 8192
    printf '\n%s\n' 'Update the patcher and run sudo chatgpt-message-visibility --apply to retry.'
  } > "$failure_temp" || return 1
  chown root:root "$failure_temp" && chmod 0644 "$failure_temp" &&
    mv -f -- "$failure_temp" "$failure_file" || return 1
  trap - EXIT HUP INT TERM
)
run_patch() {
  script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || return 1
  helper="$script_directory/patch-message-visibility.mjs"
  if [ ! -f "$helper" ]; then
    helper=/usr/local/lib/chatgpt-message-visibility/patch-message-visibility.mjs
  fi
  # Keep archive changes and the saved selection under the same writer lock.
  if [ "$operation" != --check ] && [ "$(id -u)" = 0 ]; then
    exec 9>/run/lock/chatgpt-message-visibility.lock
    flock -x 9 || return 1
  fi
  save_mode=false
  if [ "$operation" = --apply ]; then
    shift
    if [ "${1:-}" = --mode ]; then
      selected_mode=${2:-}
      # Leave argument validation to the helper before saving anything.
      if [ "$#" = 2 ]; then save_mode=true; fi
    else
      selected_mode=messages
      if [ -f "$selection" ]; then selected_mode=$(cat -- "$selection"); fi
      case "$selected_mode" in
        messages|all) ;;
        *) printf '%s\n' 'Invalid saved mode. Run --apply --mode messages or --apply --mode all to select it again.' >&2; return 1 ;;
      esac
      if [ "$#" = 0 ]; then save_mode=true; fi
      set -- --mode "$selected_mode" "$@"
    fi
    set -- --apply "$@"
  fi
  runtime=$(dpkg-query -L chatgpt 2>/dev/null | awk '/\/resources\/cua_node\/bin\/node$/ { print }')
  case "$runtime" in
    *'
'*) printf '%s\n' 'Ambiguous ChatGPT Node.js runtime.' >&2; return 1 ;;
  esac
  if [ -z "$runtime" ] || [ ! -x "$runtime" ]; then
    runtime=/usr/bin/node
    if [ ! -x "$runtime" ]; then
      printf '%s\n' 'No Node.js runtime found. Install Node.js or a ChatGPT package that bundles it.' >&2
      return 1
    fi
  fi
  "$runtime" "$helper" "$@" || return "$?"
  if [ "$save_mode" = true ] && [ "$installed" = true ] && [ "$(id -u)" = 0 ]; then
    case "$selected_mode" in messages|all) ;; *) return 1 ;; esac
    selection_temp=$(mktemp "${selection}.XXXXXX") || return 1
    trap 'rm -f -- "$selection_temp"' EXIT HUP INT TERM
    printf '%s\n' "$selected_mode" > "$selection_temp" &&
      chown root:root "$selection_temp" && chmod 0644 "$selection_temp" &&
      mv -f -- "$selection_temp" "$selection" || return 1
    trap - EXIT HUP INT TERM
    rm -f -- "$failure_file" || return 1
  fi
}
if [ "$hook" = true ]; then
  if output=$(run_patch "$@" 2>&1); then
    case "$output" in
      *'Already persistent; no changes.'*|*'Already patched in messages mode; no changes.'*|*'Already patched in all mode; no changes.'*) ;;
      *) printf '%s\n' "$output" ;;
    esac
  else
    if ! record_hook_failure "$output"; then
      printf '%s\n' 'Could not save the automatic reapplication failure status.' >&2
    fi
    printf '%s\n' "ChatGPT message visibility patch skipped: $output" >&2
    printf '%s\n' 'APT can continue. Run chatgpt-message-visibility --check to inspect this build.' >&2
  fi
  exit 0
fi
if [ "$operation" = --check ] && [ "$#" -le 1 ] && [ "$installed" = true ] && [ -f "$failure_file" ]; then
  cat -- "$failure_file" >&2 || :
fi
run_patch "$@"
